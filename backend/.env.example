# Copy to .env for local development. Never commit real values.
HERMES_ENV=development
# Local default is SQLite. Production uses PostgreSQL, e.g.:
# HERMES_DATABASE_URL=postgresql+psycopg://hermes:change-me@localhost:5432/hermes
HERMES_DATABASE_URL=sqlite:///./hermes_dev.db
HERMES_SESSION_TTL_HOURS=12
HERMES_COOKIE_SECURE=false
HERMES_CORS_ORIGINS=http://localhost:3000
# Fernet key for encrypting integration credentials. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HERMES_CREDENTIAL_ENCRYPTION_KEY=
HERMES_INVITATION_TTL_DAYS=7
HERMES_LOGIN_RATE_LIMIT=10
HERMES_LOGIN_RATE_WINDOW_SECONDS=900
# AI step (optional). Any OpenAI-compatible provider. Free options: Groq or Google AI Studio (see README).
HERMES_AI_BASE_URL=
HERMES_AI_API_KEY=
HERMES_AI_MODEL=
